# Copiar a .env.cliente (uno por restaurante) y completar.
# En Dokploy estas mismas claves van en Environment de cada App.

# Conexión a LA base de ESTE cliente (en Dokploy sale de la Database
# Postgres que le attaches; en compose manual coincide con el servicio db).
DATABASE_URL=postgresql://lumen:CAMBIAR_PASSWORD@db:5432/lumen

# Dominio personal del cliente (con https). Debe coincidir con el dominio
# configurado en Dokploy para esta App.
BETTER_AUTH_URL=https://restaurante.ejemplo.com
NEXT_PUBLIC_BASE_URL=https://restaurante.ejemplo.com

# Secreto ÚNICO por cliente (generar uno distinto cada vez):
#   openssl rand -hex 32
BETTER_AUTH_SECRET=CAMBIAR_POR_UN_SECRETO_UNICO_DE_64_HEX

# Opcional: secreto para firmar los QR de mesa. Si se omite se usa
# BETTER_AUTH_SECRET. Cambiarlo obliga a reimprimir los QR.
# PUBLIC_ORDER_SECRET=CAMBIAR_POR_OTRO_SECRETO_UNICO

# Dominios extra separados por coma (ej. www u otro alias). Opcional.
ADDITIONAL_TRUSTED_ORIGINS=

# Opcional: máximo de conexiones del pool a la base (default 10).
# DATABASE_POOL_MAX=10

# Opcional: webhook que recibe cada error de servidor en JSON
# (Discord/Slack/endpoint propio). Sin esto, los errores quedan en el log.
# ALERT_WEBHOOK_URL=

# Mercado Pago (pago online con QR de Checkout Pro).
# Sin MERCADOPAGO_ACCESS_TOKEN el menú no ofrece "Pagar con Mercado Pago".
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_NOTIFICATION_URL=https://dominio-del-cliente/api/webhooks/mercadopago
# Solo para pruebas locales/sandbox con un mock (NO usar en producción):
# MERCADOPAGO_API_BASE=http://127.0.0.1:4000
